[Unit]
Description=Orvex Wiki crew-local service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crew
Group=crew
WorkingDirectory=/home/crew/workspace/orvex-wiki
EnvironmentFile=/etc/crew/env/orvex-wiki
EnvironmentFile=/run/crew/orvex-wiki-build.env
ExecStart=/usr/bin/node /home/crew/workspace/orvex-wiki/apps/server/dist/main
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
